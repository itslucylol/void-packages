# Step 1: Use your image that already has the build environment & Eigen installed
FROM localhost/lucys-void-packages:latest

# Step 2: Set environment variables for non-interactive builds
ENV CMAKE_BUILD_PARALLEL_LEVEL=4

# Step 3: Clone OrcaSlicer into /build/OrcaSlicer
WORKDIR /build
RUN git clone --recursive https://github.com/OrcaSlicer/OrcaSlicer.git /build/OrcaSlicer

# Step 4: Build OrcaSlicer's other bundled dependencies (excluding system-provided ones)
WORKDIR /build/OrcaSlicer/deps
RUN mkdir build && cd build && \
    cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release && \
    ninja

# Step 5: Configure and build OrcaSlicer
WORKDIR /build/OrcaSlicer
RUN mkdir build && cd build && \
    cmake .. -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH="/build/OrcaSlicer/deps/build/destdir/usr/local;/usr/local" \
      -DEIGEN3_INCLUDE_DIR=/usr/local/include/eigen3 && \
    ninja

# Step 6: Define default entrypoint/command
CMD ["/build/OrcaSlicer/build/bin/orcaslicer"]