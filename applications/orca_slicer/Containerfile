FROM localhost/lvp-eigen5:latest

WORKDIR /build

# 2. Clone OrcaSlicer
RUN git clone --recursive https://github.com/OrcaSlicer/OrcaSlicer.git /build/OrcaSlicer

# 3. Build OrcaSlicer's bundled dependencies
WORKDIR /build/OrcaSlicer/deps
RUN mkdir build && cd build && \
    cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release && \
    ninja

# 4. Build OrcaSlicer using your isolated Eigen 5 headers
WORKDIR /build/OrcaSlicer
RUN mkdir build && cd build && \
    cmake .. -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH="/build/OrcaSlicer/deps/build/destdir/usr/local;/opt/eigen5" \
      -DEIGEN3_INCLUDE_DIR=/opt/eigen5/include/eigen3 \
      -DCMAKE_INSTALL_PREFIX=/opt/orcaslicer-portable && \
    ninja && \
    ninja install

# 5. Compress the installed output into a portable tarball
WORKDIR /opt
RUN tar -czvf /orcaslicer-portable.tar.gz orcaslicer-portable